# Backend local environment

APP_ENV=local
DATABASE_URL=postgresql+asyncpg://sheyunqilv:sheyunqilv@localhost:5432/sheyunqilv

# JWT secrets (use `openssl rand -hex 32` to generate)
APP_JWT_SECRET=change-me-app-jwt-secret-min-32-chars
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars

APP_JWT_ISSUER=sheyunqilv-app
APP_JWT_AUDIENCE=sheyunqilv-miniapp
ADMIN_JWT_ISSUER=sheyunqilv-admin
ADMIN_JWT_AUDIENCE=sheyunqilv-web

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Initial admin seed
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin-password
