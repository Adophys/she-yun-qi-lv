# Backend local environment

APP_ENV=local

# 数据库：默认 PostgreSQL（需先 docker compose up -d 起数据库）；临时切 SQLite 用下面注释那行
# 宿主端口用 5434 避开本地已装的 PG 16(5432)/PG 18(5433) 服务
DATABASE_URL=postgresql+asyncpg://sheyunqilv:sheyunqilv@localhost:5434/sheyunqilv
# DATABASE_URL=sqlite+aiosqlite:///./sheyunqilv.db

# JWT secrets (use `openssl rand -hex 32` to generate)
APP_JWT_SECRET=change-me-app-jwt-secret-min-32-chars
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars

APP_JWT_ISSUER=sheyunqilv-app
APP_JWT_AUDIENCE=sheyunqilv-miniapp
ADMIN_JWT_ISSUER=sheyunqilv-admin
ADMIN_JWT_AUDIENCE=sheyunqilv-web

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Initial admin seed
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin-password

# WeChat mini-program (login)
WECHAT_APPID=wx0000000000000000
WECHAT_APP_SECRET=change-me-wechat-app-secret

# WeChat Pay (scheme A, real payment)
SHOP_PAYMENT_ENABLED=false
WECHAT_PAY_MCHID=1900000000
WECHAT_PAY_APPID=wx0000000000000000
WECHAT_PAY_API_V3_KEY=change-me-apiv3-key
WECHAT_PAY_SERIAL_NO=change-me-serial-no
WECHAT_PAY_PRIVATE_KEY_PATH=./secrets/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/app/shop/pay/notify
