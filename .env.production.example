# Production environment template
# Copy to .env.production and fill in real values before deployment

# Database
DATABASE_URL=postgresql+asyncpg://sheyunqilv:CHANGE_ME@postgres:5432/sheyunqilv

# PostgreSQL container
POSTGRES_DB=sheyunqilv
POSTGRES_USER=sheyunqilv
POSTGRES_PASSWORD=CHANGE_ME

# JWT secrets - use `openssl rand -hex 32`
APP_JWT_SECRET=CHANGE_ME_APP_JWT_SECRET_MIN_32_CHARS
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET_MIN_32_CHARS

# Token TTL
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Initial admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# 微信小程序（资质办齐后填真实值；未填时 wx-login 走 mock 模式，仅供联调）
WECHAT_APPID=
WECHAT_SECRET=

# 商城真实支付 feature flag：资质未办齐前保持 false（前端降级为意向收集）
SHOP_PAYMENT_ENABLED=false

# Nginx
NGINX_SITE_CONFIG=http
