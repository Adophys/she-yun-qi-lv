# ============================================================
# 畲韵奇旅 · 管理端环境变量模板
# 用法：复制本文件为 .env 后按需修改
#   cp .env.example .env            # 所有环境生效
#   cp .env.example .env.development # 仅本地开发
#   cp .env.example .env.production  # 仅生产构建
# 修改后需重启 dev server / 重新执行 build 才会生效
# ============================================================

# ── 后端接口基础地址 ─────────────────────────────────────────
# 前端所有请求的 API 基础路径（src/api/http.ts 读取）。
# - 默认 /api/v1：开发时由 Vite Mock 服务器拦截；生产由 nginx 同域转发
# - 设为完整地址（如 https://api.example.com/api/v1）时，所有请求
#   直接发往该后端，绕过 Mock —— 页面代码无需任何改动即可无缝切换
VITE_API_BASE_URL=/api/v1

# ── 点位 H5 页面根地址 ──────────────────────────────────────
# 点位管理页生成二维码时使用的 H5 端访问根地址
# （src/views/PointsView.vue 读取，示例域名仅用于本地 Mock 演示）
# 部署时改为实际 H5 域名，如 https://h5.your-domain.com
VITE_POINT_WEB_BASE=https://sheyun.example.com

# ── 开发代理后端地址（仅本地开发使用，不随前端打包）────────────
# 本地开发时 Vite 将 /api、/health 请求代理到该后端
# （vite.config.ts 读取，仅在未配置 VITE_API_BASE_URL 直连时生效）
# 对接真实后端时改为后端服务地址，如 http://192.168.1.10:8000
PROXY_TARGET=http://127.0.0.1:8000
